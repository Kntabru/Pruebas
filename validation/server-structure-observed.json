  {
    "schema": "public",
    "name": "competition_rounds",
    "columns": [
      {
        "tipo": "uuid",
        "columna": "id",
        "default": "gen_random_uuid()",
        "not_null": true
      },
      {
        "tipo": "uuid",
        "columna": "challenge_id",
        "default": null,
        "not_null": true
      },
      {
        "tipo": "uuid",
        "columna": "user_id",
        "default": null,
        "not_null": true
      },
      {
        "tipo": "text",
        "columna": "status",
        "default": "'playing'::text",
        "not_null": true
      },
      {
        "tipo": "smallint",
        "columna": "attempts",
        "default": "0",
        "not_null": true
      },
      {
        "tipo": "timestamp with time zone",
        "columna": "started_at",
        "default": "now()",
        "not_null": true
      },
      {
        "tipo": "timestamp with time zone",
        "columna": "finished_at",
        "default": null,
        "not_null": false
      },
      {
        "tipo": "bigint",
        "columna": "duration_ms",
        "default": null,
        "not_null": false
      },
      {
        "tipo": "integer",
        "columna": "points",
        "default": "\\nCASE\\n    WHEN (status = 'won'::text) THEN palabreo_points((attempts)::integer)\\n    ELSE 0\\nEND",
        "not_null": false
      }
    ],
    "constraints": [
      {
        "nombre": "competition_rounds_attempts_check",
        "definicion": "CHECK (attempts >= 0 AND attempts <= 6)"
      },
      {
        "nombre": "competition_rounds_challenge_id_fkey",
        "definicion": "FOREIGN KEY (challenge_id) REFERENCES challenges(id) ON DELETE CASCADE"
      },
      {
        "nombre": "competition_rounds_challenge_id_user_id_key",
        "definicion": "UNIQUE (challenge_id, user_id)"
      },
      {
        "nombre": "competition_rounds_check",
        "definicion": "CHECK (status = 'playing'::text AND finished_at IS NULL AND duration_ms IS NULL AND attempts < 6 OR status = 'won'::text AND attempts >= 1 AND attempts <= 6 AND finished_at IS NOT NULL AND duration_ms IS NOT NULL OR status = 'lost'::text AND attempts = 6 AND finished_at IS NOT NULL AND duration_ms IS NOT NULL OR status = 'abandoned'::text AND finished_at IS NOT NULL)"
      },
      {
        "nombre": "competition_rounds_check1",
        "definicion": "CHECK (finished_at IS NULL OR finished_at >= started_at)"
      },
      {
        "nombre": "competition_rounds_duration_ms_check",
        "definicion": "CHECK (duration_ms >= 0)"
      },
      {
        "nombre": "competition_rounds_pkey",
        "definicion": "PRIMARY KEY (id)"
      },
      {
        "nombre": "competition_rounds_status_check",
        "definicion": "CHECK (status = ANY (ARRAY['playing'::text, 'won'::text, 'lost'::text, 'abandoned'::text]))"
      },
      {
        "nombre": "competition_rounds_user_id_fkey",
        "definicion": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE"
      }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX competition_rounds_pkey ON public.competition_rounds USING btree (id)",
      "CREATE UNIQUE INDEX competition_rounds_challenge_id_user_id_key ON public.competition_rounds USING btree (challenge_id, user_id)",
      "CREATE INDEX competition_rounds_user ON public.competition_rounds USING btree (user_id)"
    ]
  },
